# Agents Environment Configuration
# Copy to .env and fill in your values

# Agent Seeds (CHANGE IN PRODUCTION!)
CLASSIFICATION_AGENT_SEED=civicpulse-classification-agent-seed-change-in-production
DUPLICATE_AGENT_SEED=civicpulse-duplicate-agent-seed-change-in-production
PRIORITY_AGENT_SEED=civicpulse-priority-agent-seed-change-in-production
ROUTING_AGENT_SEED=civicpulse-routing-agent-seed-change-in-production
MONITORING_AGENT_SEED=civicpulse-monitoring-agent-seed-change-in-production

# Agent Ports
CLASSIFICATION_AGENT_PORT=8001
DUPLICATE_AGENT_PORT=8002
PRIORITY_AGENT_PORT=8003
ROUTING_AGENT_PORT=8004
MONITORING_AGENT_PORT=8005

# Agent Endpoints
CLASSIFICATION_AGENT_ENDPOINT=http://localhost:8001/submit
DUPLICATE_AGENT_ENDPOINT=http://localhost:8002/submit
PRIORITY_AGENT_ENDPOINT=http://localhost:8003/submit
ROUTING_AGENT_ENDPOINT=http://localhost:8004/submit
MONITORING_AGENT_ENDPOINT=http://localhost:8005/submit

# Agent Addresses (for inter-agent communication)
CLASSIFICATION_AGENT_ADDRESS=
DUPLICATE_AGENT_ADDRESS=
PRIORITY_AGENT_ADDRESS=
ROUTING_AGENT_ADDRESS=
MONITORING_AGENT_ADDRESS=

# Funding (set to true to auto-fund from testnet)
FUND_AGENT=false